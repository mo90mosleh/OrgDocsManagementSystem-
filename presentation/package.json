{
  "name": "orgdocs-management-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-demo.mjs && node scripts/validate-artifact.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "typecheck": "tsc -p portal/tsconfig.json",
    "test:e2e": "playwright test",
    "publish:pages": "npm run build && node scripts/publish-pages.mjs",
    "build:pages": "PAGES_SNAPSHOT=1 npm run build"
  },
  "dependencies": {
    "lucide-react": "0.575.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "esbuild": "0.25.12",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
